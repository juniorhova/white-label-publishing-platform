# Set these in Coolify Environment Variables.
# Do not commit real production secrets.

DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
PAYLOAD_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SERVER_URL=https://your-domain.example.com
CRON_SECRET=replace-with-a-long-random-secret
PREVIEW_SECRET=replace-with-a-long-random-secret

# Entra ID SSO for Payload admin. Register this exact production callback URL in Entra:
# https://your-domain.example.com/api/auth/entra/callback
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-application-client-id
ENTRA_CLIENT_SECRET=replace-with-entra-client-secret
ENTRA_REDIRECT_URI=https://your-domain.example.com/api/auth/entra/callback
ENTRA_ALLOWED_EMAILS=owner@example.com
ENTRA_VALIDATE_MFA_CLAIM=false

# Break-glass fallback account allowed to use Payload email/password.
PAYLOAD_PASSWORD_LOGIN_ALLOWED_EMAILS=owner@example.com
