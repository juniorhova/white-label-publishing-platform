# Database connection string
DATABASE_URL=postgres://postgres:localpassword@127.0.0.1:5432/white-label-publishing-platform

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Optional local Entra ID SSO for Payload admin.
# Register this redirect URI in Entra for local testing:
# http://localhost:3000/api/auth/entra/callback
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:3000/api/auth/entra/callback
ENTRA_ALLOWED_EMAILS=owner@example.com
ENTRA_VALIDATE_MFA_CLAIM=false

# When Entra SSO is configured, only these emails may use Payload email/password login.
PAYLOAD_PASSWORD_LOGIN_ALLOWED_EMAILS=owner@example.com

# Optional private AWS S3 storage for Media. Never use NEXT_PUBLIC_ for credentials.
# Enable all five variables in Coolify at build time AND runtime. See docs/s3-storage.md.
S3_ENABLED=false
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional public article interactions: public key at build/runtime, secret at runtime.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
